// Firestore security rules for the Madness Schedule app.
// Guards database access so only allowed users can read or write.
// RELEVANT FILES: firebase.json, firestore.indexes.json, functions/index.js
// FILE: firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token != null
        && ('admin' in request.auth.token)
        && request.auth.token.admin == true;
    }
    
    // ===== REEL VALIDATION (used by match /reels below) =====
    // A reel holds only these fields, with size limits; the button link must be https or empty.
    function validReel(d) {
      return d.keys().hasOnly(['eyebrow', 'title', 'highlight', 'description', 'ctaText', 'ctaUrl',
                               'footer', 'seconds', 'active', 'order', 'updatedAt',
                               'align', 'position', 'size', 'logo', 'background', 'frequency'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.eyebrow is string && d.eyebrow.size() <= 60
        && d.highlight is string && d.highlight.size() <= 60
        && d.description is string && d.description.size() <= 200
        && d.ctaText is string && d.ctaText.size() <= 40
        && d.ctaUrl is string && d.ctaUrl.size() <= 500 && (d.ctaUrl == '' || d.ctaUrl.matches('https://.*'))
        && d.footer is string && d.footer.size() <= 80
        && d.seconds is int && d.seconds >= 3 && d.seconds <= 15
        && d.active is bool && d.order is number && d.updatedAt is timestamp
        // Layout choices are optional: reels saved before they existed must still be editable.
        && (!('align' in d) || d.align in ['left', 'center'])
        && (!('position' in d) || d.position in ['top', 'middle', 'bottom'])
        && (!('size' in d) || d.size in ['s', 'm', 'l'])
        && (!('logo' in d) || d.logo is bool)
        && (!('background' in d) || d.background in ['texture', 'arcs', 'plain', 'trx', 'yoga', 'hiit', 'functional', 'capoeira'])
        && (!('frequency' in d) || d.frequency in ['daily3', 'daily', 'once', 'always']);
    }

    // ===== CLASSES (Refined) =====
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

    }

    // ===== BOOKINGS =====
    match /bookings/{bookingId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===== USERS (Final, Simpler Ruleset) =====
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) ||
      isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'subscriptionType']);
      allow update: if (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'fcmTokens', 'fcmUpdatedAt', 'displayName', 'photoURL',
            'lastActivity', 'lastCancelAt', 'totalPass', 'subscriptionType'
          ])
          && !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'totalPassVerified', 'subscriptionPaidDate', 'subscriptionStatus'
          ])
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
      ) ||
      isAdmin();
    }

    // ===== ATTENDANCE =====
    match /attendance/{doc} {
      allow read: if isAdmin() || (
        isSignedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // ===== SCHEDULE TEMPLATE =====
    match /schedule_template/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ===== WAITLISTS =====
    match /waitlists/{waitlistId} {    
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // ===== NOTIFICATIONS (admin-only) =====
    match /notifications/{notifId} {
        allow read, write: if isAdmin();
    }

    // ===== DAILY MESSAGES =====
    match /dailyMessages/{messageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ===== FEEDBACK REEL SETTING =====
    match /appSettings/feedbackReel {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    // ===== BANNER ABOVE THE MEMBER MENU (edited in admin → Avisos) =====
    match /appSettings/feedbackBanner {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'title', 'linkText', 'url'])
        && request.resource.data.enabled is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.linkText is string && request.resource.data.linkText.size() <= 40
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('https://.*');
      allow delete: if false;
    }

    // ===== REPORT SETTINGS (price per class for estimated revenue) =====
    match /appSettings/reports {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ticketPrice'])
        && request.resource.data.ticketPrice is number
        && request.resource.data.ticketPrice > 0;
      allow delete: if false;
    }

    // ===== REELS (story shown when members open the app; edited in admin → Avisos) =====
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validReel(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===== Everything else locked =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
